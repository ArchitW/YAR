# Copy to .env and adjust. Never commit real credentials.
# Defaults defined in backend/app/core/config.py are used when a value is unset.

# Auth – Set AUTH_ENABLED=true to enforce JWT authentication across endpoints.
# When enabled, JWT_SECRET is REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_ENABLED=false
JWT_SECRET=

# DATABASE_URL=sqlite:////absolute/path/to/yar.db
# UPLOAD_DIR=/absolute/path/to/uploads
# QDRANT_URL=http://localhost:6333

# LLM gateway (any OpenAI-compatible /chat/completions endpoint).
# Leave LLM_BASE_URL or LLM_MODEL empty to use the extractive fallback.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=
LLM_TIMEOUT=60
